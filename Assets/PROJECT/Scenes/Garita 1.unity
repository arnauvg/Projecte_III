  m_IsActive: 1
--- !u!114 &1828898097
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1828898096}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a386dd74a8d94df4f8b4221cd5164ef7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  uiDocument: {fileID: 1828898098}
  dialogues:
  - speakerName: Jefe
    sentences:
    - "\xA1Eh, Johnny! Por fin coges el tel\xE9fono. Soy Don Ernesto, tu jefe."
    - "El anterior vigilante\u2026 desapareci\xF3. Pero no te rayes, \xBFvale? Bueno,
      un poco s\xED."
    - Abre el manual de criaturas que tienes en la mesa. Es el libro amarillo.
    - "Ah\xED ver\xE1s seres m\xE1gicos que vienen a hacer el mal: vampiros, brujas,
      diablos\u2026"
    - "Cada criatura tiene sus caracter\xEDsticas. Est\xFAdiatelas bien o la liar\xE1s."
    - Cuando aparezca alguien en la ventanilla de la garita, usa el manual para identificar.
    - "Si es malo, pulsa el bot\xF3n ROJO: no pasa. Si es inofensivo, pulsa VERDE
      y que entre."
    - "Pero si dejas pasar a un vampiro o a una bruja\u2026 te aseguro que te quedas
      sin sueldo."
    - El cementerio es sagrado, no podemos permitir magia negra ni vandalismo.
    - "\xBFQueda claro? Me juego el prestigio contigo. A la m\xEDnima, est\xE1s despedido."
    - "Tambi\xE9n tendr\xE1s tareas extras que hacer antes de que acabe la noche."
    - "Pero de eso ya te hablar\xE9 cuando surjan. Por ahora, centrate en la entrada."
    - "En fin\u2026 empieza ya. No me falles, que el que falla se va al paro."
  charDelay: 0.015
  typingSound: {fileID: 8300000, guid: 17be527c9e0ba964ea842b843bd4b89a, type: 3}
  audioSource: {fileID: 0}
