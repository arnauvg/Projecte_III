<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/FinNoche/PantallaFinNoche.uss?fileID=7433441132597879392&amp;guid=98cd0e60e1b4f3c41bad2d170cce058b&amp;type=3#PantallaFinNoche" />
    <ui:VisualElement class="fondo" style="flex-grow: 1; background-color: rgb(24, 5, 40); justify-content: center; align-items: center; align-self: auto;">
        <ui:Label text="Noche 1&#10;" name="noche" class="titulo" style="color: rgb(255, 255, 255); font-size: 50%; -unity-font-style: bold;" />
        <ui:Label text="COMPLETADA" name="estado" class="estado" style="font-size: 20%; color: rgb(255, 255, 255);" />
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; padding-top: 20px; padding-bottom: 20px;">
            <ui:Label text="Resultados" name="Label" class="estado resultados" style="color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: upper-center; font-size: 14%;" />
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-direction: row;">
                <ui:VisualElement style="flex-grow: 0; flex-direction: column; align-self: auto; flex-shrink: 0; padding-right: 20px;">
                    <ui:Label text="Visitantes correctos:&#10;" parse-escape-sequences="true" class="descripcio" style="color: rgb(255, 255, 255); font-size: 14%;" />
                    <ui:Label text="Tareas completadas:&#10;" class="descripcio" style="color: rgb(255, 255, 255); font-size: 14%;" />
                    <ui:Label text="Total sueldo:" class="descripcio" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 14%;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-direction: column; flex-shrink: 0; padding-right: 20px;">
                    <ui:Label text="1/1&#10;" name="num-visitantes" class="valor" style="color: rgb(255, 255, 255); font-size: 14%;" />
                    <ui:Label text="2/2" name="num-tareas" class="valor" style="color: rgb(255, 255, 255); font-size: 14%;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-direction: column; align-self: auto; flex-shrink: 0;">
                    <ui:Label text="- 0 €&#10;" name="dinero-visitantes" class="penalizacion" style="color: rgb(255, 255, 255); font-size: 14%;" />
                    <ui:Label text="- 0 €&#10;" name="dinero-tareas" class="penalizacion" style="color: rgb(255, 255, 255); font-size: 14%;" />
                    <ui:Label text="1500 €" name="sueldo" class="sueldo" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 14%;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="Siguiente noche" name="boton-siguiente" class="boton-siguiente" style="background-color: rgb(202, 142, 255); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; font-size: 14%;" />
    </ui:VisualElement>
</ui:UXML>
