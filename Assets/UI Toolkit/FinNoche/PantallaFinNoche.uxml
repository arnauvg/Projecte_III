        <ui:Label text="COMPLETADA" name="estado" class="estado" style="font-size: 20%; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/PROJECT/Typography/Brown%20Cookies.otf?fileID=12800000&amp;guid=a5288a96f96ec874eaca9aab69c3c6cd&amp;type=3#Brown Cookies&quot;);" />
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; padding-top: 20px; padding-bottom: 20px;">
            <ui:Label text="Resultados" name="Label" class="estado resultados" style="color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: upper-center; font-size: 14%; -unity-font-definition: url(&quot;project://database/Assets/PROJECT/Typography/Brown%20Cookies.otf?fileID=12800000&amp;guid=a5288a96f96ec874eaca9aab69c3c6cd&amp;type=3#Brown Cookies&quot;);" />
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-direction: row;">
