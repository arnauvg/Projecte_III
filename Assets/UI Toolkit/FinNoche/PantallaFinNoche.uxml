                    <ui:Label text="Visitantes correctos:&#10;" parse-escape-sequences="true" class="descripcio" style="color: rgb(255, 255, 255); font-size: 14%; -unity-font-definition: url(&quot;project://database/Assets/PROJECT/Typography/Brown%20Cookies.otf?fileID=12800000&amp;guid=a5288a96f96ec874eaca9aab69c3c6cd&amp;type=3#Brown Cookies&quot;);" />
                    <ui:Label text="Tareas completadas:&#10;" class="descripcio" style="color: rgb(255, 255, 255); font-size: 14%; -unity-font-definition: url(&quot;project://database/Assets/PROJECT/Typography/Brown%20Cookies.otf?fileID=12800000&amp;guid=a5288a96f96ec874eaca9aab69c3c6cd&amp;type=3#Brown Cookies&quot;);" />
                    <ui:Label text="Total sueldo:" class="descripcio" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 14%; -unity-font-definition: url(&quot;project://database/Assets/PROJECT/Typography/Brown%20Cookies.otf?fileID=12800000&amp;guid=a5288a96f96ec874eaca9aab69c3c6cd&amp;type=3#Brown Cookies&quot;);" />
