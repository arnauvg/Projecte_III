                    <ui:Label text="1500 €" name="sueldo" class="sueldo" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 14%; -unity-font-definition: url(&quot;project://database/Assets/PROJECT/Typography/Brown%20Cookies.otf?fileID=12800000&amp;guid=a5288a96f96ec874eaca9aab69c3c6cd&amp;type=3#Brown Cookies&quot;);" />
